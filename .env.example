# =================================────────────────────────────
# Log Viewer — cấu hình MinIO
# Điền giá trị thật của bạn vào đây rồi khởi động lại app
# (hoặc mở app và nhập trực tiếp trong màn hình Cài đặt)
# =================================────────────────────────────

# URL chính của trang MinIO Console (trang web bạn hay mở để xem bucket)
# Dán cả link /browser/... cũng được — app tự tách bucket
MINIO_CONSOLE_URL=

# URL trang đăng nhập (tùy chọn, nếu khác URL chính)
# Ví dụ: https://minio.uongoc.vn/login
MINIO_LOGIN_URL=

# Tên đăng nhập + mật khẩu của trang MinIO Console
MINIO_USERNAME=
MINIO_PASSWORD=

# Bucket chứa log (để trống thì app tự lấy danh sách bucket để bạn chọn)
MINIO_BANK_TRANSACTION_BUCKET=

# S3 API endpoint — KHÔNG cần điền: app tự đăng nhập console,
# tự dò endpoint và lưu lại vào đây sau lần đầu
MINIO_URL=

# ---- Tuỳ chọn (không bắt buộc) ----
# Cổng HTTP của app (mặc định 8765)
#PORT=8765

# Thư mục cache log đã tải về (mặc định: log-cache cạnh file chạy).
# Có thể chọn bằng nút "📂 Chọn thư mục..." trong Cài đặt của app.
#CACHE_DIR=

# Giữ lại file .tar.gz sau khi giải nén (true/false, mặc định false = chỉ giữ log đã giải nén, tiết kiệm đĩa)
#KEEP_ARCHIVES=false

# Tự động xóa cache log cũ hơn N ngày khi mở app (0 = tắt, mặc định 14)
#AUTO_CLEAN_DAYS=14
